{
  "extends": "@jetnine/config/tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2022",
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": false
  },
  "include": ["src/**/*"],
  // seed.ts runs via tsx (`pnpm seed`), never from dist, and it's the only
  // file here importing @jetnine/shared — compiling it would force shared
  // to build before db, which broke deploys that build db first.
  "exclude": ["node_modules", "dist", "drizzle", "src/seed.ts"]
}
