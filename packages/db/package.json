{
  "name": "@jetnine/db",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    }
  },
  "files": [
    "dist",
    "drizzle",
    "src/migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "reset": "tsx src/reset.ts",
    "seed": "tsx src/seed.ts",
    "check": "drizzle-kit check",
    "test": "vitest run"
  },
  "dependencies": {
    "@jetnine/shared": "workspace:*",
    "better-auth": "^1.6.9",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@jetnine/config": "workspace:*",
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
