{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile --prod=false",
  "buildCommand": "cd ../.. && pnpm turbo build --filter=@jetnine/web",
  "outputDirectory": ".next",
  "ignoreCommand": "npx turbo-ignore @jetnine/web",
  "functions": {
    "src/pages/api/[...path].ts": {
      "memory": 3008,
      "maxDuration": 60
    }
  }
}
